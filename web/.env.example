# ─────────────────────────────────────────────────────────────
#  KiuQ Workflow System — web (Vue 3) environment
#  Copy this file to `.env` and fill in real values.
#  Only VITE_* variables are exposed to the client bundle.
#  NEVER put a Supabase service_role key in this file.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Firebase (used for web push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Server-only secrets (do NOT prefix with VITE_, never commit) ──
# These are consumed by backend tooling / Edge Functions, not the client.
#   SUPABASE_SERVICE_KEY=   # service_role key — keep in a server env only
#   WEBSITE_API_SECRET=     # shared secret for receiver push
